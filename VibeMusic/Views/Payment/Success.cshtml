@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="container py-5 text-center">
    <div class="glass-morphism p-5 mx-auto" style="max-width: 600px;">
        <i class="bi bi-check-circle-fill text-success display-1 mb-4"></i>
        <h1 class="text-white fw-bold mb-3">Thanh toán thành công!</h1>
        <p class="text-white-50 fs-5 mb-5">Cảm ơn bạn đã đăng ký gói Premium. Tài khoản của bạn đã được nâng cấp.</p>
        <a href="/" class="btn btn-premium px-5 py-3">BẮT ĐẦU NGHE NHẠC</a>
    </div>
</div>

@section Scripts {
    <script>
        // Immediately sync the Premium state for the current SPA session
        if (window.YTM_CONFIG) {
            console.log("[Payment] Syncing Premium status to true...");
            window.YTM_CONFIG.isPremium = true;
        }
        
        // Also update the global flag for legacy views
        window.userIsPremium = true;
    </script>
}
