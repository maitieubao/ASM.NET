@model YoutubeMusicPlayer.Application.DTOs.ReportDto
@{
    ViewData["Title"] = "Report Details";
}

<div class="container mt-4 pb-5 text-white">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to reports
        </a>
        <h2 class="fw-bold"><i class="bi bi-flag-fill me-2 text-danger"></i> Report Details</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="glass-panel">
                <h5 class="fw-bold mb-3">Summary</h5>
                <div class="mb-2"><span class="text-white-50">Status:</span> <span class="badge @(Model.Status == "Pending" ? "bg-danger" : Model.Status == "Resolved" ? "bg-success" : "bg-secondary")">@Model.Status</span></div>
                <div class="mb-2"><span class="text-white-50">Reporter:</span> @Model.UserName</div>
                <div class="mb-2"><span class="text-white-50">Target Type:</span> @Model.TargetType</div>
                <div class="mb-2"><span class="text-white-50">Target Name:</span> @Model.TargetName</div>
                <div class="mb-2"><span class="text-white-50">Target ID:</span> @Model.TargetId</div>
                <div class="mb-2"><span class="text-white-50">Created:</span> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                @if (Model.ResolvedAt.HasValue)
                {
                    <div><span class="text-white-50">Resolved:</span> @Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-panel">
                <h5 class="fw-bold mb-3">Reason</h5>
                <div class="fs-5 mb-3">@Model.Reason</div>
                <h6 class="text-white-50">Details</h6>
                <p class="mb-0">@(!string.IsNullOrWhiteSpace(Model.Details) ? Model.Details : "No additional details were provided.")</p>
            </div>
        </div>
    </div>
</div>
