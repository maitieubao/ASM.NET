@model IEnumerable<YoutubeMusicPlayer.Application.DTOs.PaymentDto>
@{
    ViewData["Title"] = "Recent Transactions";
    var payments = Model ?? Enumerable.Empty<YoutubeMusicPlayer.Application.DTOs.PaymentDto>();
}

<div class="container py-5 animate-fade-in">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="text-white fw-black m-0">Recent Transactions</h1>
            <p class="text-dim">Review the latest successful premium payments on the platform.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 fw-bold">Back To Plans</a>
    </div>

    <div class="glass-card overflow-hidden">
        <table class="modern-table">
            <thead>
                <tr>
                    <th class="ps-4">Order Code</th>
                    <th>Plan</th>
                    <th>Amount</th>
                    <th>Payment Date</th>
                    <th class="text-end pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in payments)
                {
                    <tr>
                        <td class="ps-4 text-dim small">#@payment.OrderCode</td>
                        <td>
                            <div class="fw-bold text-main">@payment.PlanName</div>
                            <div class="text-dim extra-small">PayOS Transaction</div>
                        </td>
                        <td class="text-accent fw-bold">@String.Format("{0:N0} VND", payment.Amount)</td>
                        <td class="text-dim small">@payment.PaymentDate.ToString("HH:mm dd/MM/yyyy")</td>
                        <td class="text-end pe-4">
                            <span class="badge @(payment.Status == "Success" ? "bg-success" : (payment.Status == "Pending" ? "bg-warning" : "bg-danger")) bg-opacity-20 text-@(payment.Status == "Success" ? "success" : (payment.Status == "Pending" ? "warning" : "danger")) px-3 py-2 rounded-pill small fw-bold">
                                @payment.Status
                            </span>
                        </td>
                    </tr>
                }

                @if (!payments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-dim">
                            <i class="fa-solid fa-receipt display-4 mb-3 opacity-10"></i>
                            <p>No transactions available.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(40, 40, 40, 0.4);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
    }
</style>
