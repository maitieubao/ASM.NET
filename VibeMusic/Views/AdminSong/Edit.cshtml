@model VibeMusic.Application.DTOs.SongDto
@{
    ViewData["Title"] = "Edit Song";
    var genres = ViewBag.Genres as IEnumerable<VibeMusic.Application.DTOs.GenreDto> ?? new List<VibeMusic.Application.DTOs.GenreDto>();
}

<div class="container mt-4 pb-5 text-white animate-fade-in">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-black m-0">Edit Song</h2>
            <div class="text-dim small">ID: #@Model.SongId • @Model.PlayCount plays</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Cancel</a>
            <button type="submit" form="songForm" class="btn btn-accent rounded-pill px-5 fw-bold">Save Song</button>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-4">
            <div class="glass-card p-4 rounded-5 border-0 shadow-lg text-center mb-4 sticky-sidebar" style="top: 100px;">
                <div class="position-relative mb-4 group">
                    <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "https://placehold.co/600x600/111/444?text=Preview" : Model.ThumbnailUrl)" class="w-100 rounded-4 shadow-2xl" style="aspect-ratio: 1; object-fit: cover;">
                </div>
                <h4 class="fw-bold text-white mb-1">@Model.Title</h4>
                <div class="text-dim small mb-4">Youtube ID: @Model.YoutubeVideoId</div>

                <div class="d-grid gap-2">
                    <a href="https://www.youtube.com/watch?v=@Model.YoutubeVideoId" target="_blank" class="btn btn-outline-danger rounded-pill fw-bold btn-sm py-2">
                        <i class="fa-brands fa-youtube me-2"></i>Open On YouTube
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <form id="songForm" asp-action="Edit" method="post">
                <input type="hidden" asp-for="SongId" />
                <input type="hidden" asp-for="Duration" />

                <div class="glass-card rounded-5 border-0 overflow-hidden shadow-2xl">
                    <ul class="nav nav-tabs admin-tabs border-0 px-4 pt-4" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general-info" type="button">General</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#lyrics-tab" type="button">Lyrics</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#config-tab" type="button">Settings</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#viewcount-tab" type="button">View Count</button>
                        </li>
                    </ul>

                    <div class="tab-content p-5">
                        <div class="tab-pane fade show active" id="general-info">
                            <div class="row g-4">
                                <div class="col-12">
                                    <label class="form-label x-small uppercase fw-bold text-dim">Song Title</label>
                                    <input asp-for="Title" class="form-control-pro" placeholder="Song title..." required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label x-small uppercase fw-bold text-dim">Album ID</label>
                                    <input asp-for="AlbumId" type="number" class="form-control-pro" placeholder="Album ID..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label x-small uppercase fw-bold text-dim">Youtube Video ID</label>
                                    <input asp-for="YoutubeVideoId" class="form-control-pro" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label x-small uppercase fw-bold text-dim">Thumbnail URL</label>
                                    <input asp-for="ThumbnailUrl" class="form-control-pro" placeholder="https://..." />
                                </div>
                                <div class="col-12">
                                    <label class="form-label x-small uppercase fw-bold text-dim">Genres</label>
                                    <div class="genre-selector-grid p-4 rounded-4 bg-dark bg-opacity-25 border border-white border-opacity-5">
                                        <div class="row row-cols-2 row-cols-md-3 g-3">
                                            @foreach (var genre in genres)
                                            {
                                                <div class="col">
                                                    <div class="form-check custom-check">
                                                        <input class="form-check-input" type="checkbox" name="GenreIds" value="@genre.GenreId" id="g-@genre.GenreId" @(Model.GenreIds.Contains(genre.GenreId) ? "checked" : "")>
                                                        <label class="form-check-label small" for="g-@genre.GenreId">@genre.Name</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="lyrics-tab">
                            <div class="mb-4">
                                <label class="form-label x-small uppercase fw-bold text-dim">Lyrics</label>
                                <textarea asp-for="LyricsText" class="form-control-pro font-monospace" rows="15" placeholder="Song lyrics..."></textarea>
                            </div>
                            <div>
                                <label class="form-label x-small uppercase fw-bold text-dim">Lyrics Sync URL</label>
                                <input asp-for="LyricsSyncUrl" type="text" class="form-control-pro" placeholder="https://example.com/sync-lyrics.lrc" />
                            </div>
                        </div>

                        <div class="tab-pane fade" id="config-tab">
                            <div class="row g-5">
                                <div class="col-md-6">
                                    <div class="config-card glass-card p-4 rounded-4 border-0">
                                        <h6 class="fw-bold mb-3">Rights</h6>
                                        <div class="mb-3">
                                            <label class="form-label x-small uppercase fw-bold text-dim">ISRC</label>
                                            <input asp-for="Isrc" type="text" class="form-control-pro" placeholder="Optional ISRC" />
                                        </div>
                                        <div class="form-check form-switch p-0 m-0 d-flex align-items-center gap-3">
                                            <input class="form-check-input ms-0 cursor-pointer" type="checkbox" role="switch" asp-for="IsExplicit">
                                            <label class="form-check-label small" asp-for="IsExplicit">Explicit Content</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="config-card glass-card p-4 rounded-4 border-0">
                                        <h6 class="fw-bold mb-3">Access</h6>
                                        <div class="form-check form-switch p-0 m-0 d-flex align-items-center gap-3 mb-3">
                                            <input class="form-check-input ms-0 cursor-pointer" type="checkbox" role="switch" asp-for="IsPremiumOnly">
                                            <label class="form-check-label small" asp-for="IsPremiumOnly">Premium Only</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="viewcount-tab">
                            <div class="row g-4">
                                <div class="col-12">
                                    <h6 class="fw-bold mb-3">View Count Management</h6>
                                    <!-- Current view count display (loaded async) -->
                                    <div id="viewCountInfo" class="glass-card p-4 rounded-4 border-0 mb-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spinner-border spinner-border-sm text-accent" role="status" id="viewCountSpinner">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span class="text-dim small" id="viewCountText">Đang tải view count...</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="config-card glass-card p-4 rounded-4 border-0">
                                        <h6 class="fw-bold mb-3">Nguồn View Count Ưu tiên</h6>
                                        <label class="form-label x-small uppercase fw-bold text-dim">Priority Source</label>
                                        <select id="prioritySourceSelect" class="form-control-pro mb-3">
                                            <option value="">Auto (Cao nhất)</option>
                                            <option value="0">Internal</option>
                                            <option value="1">YouTube</option>
                                            <option value="2">Deezer</option>
                                        </select>
                                        <button type="button" id="savePriorityBtn" class="btn btn-accent rounded-pill px-4 fw-bold btn-sm">
                                            💾 Lưu Priority Source
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="config-card glass-card p-4 rounded-4 border-0">
                                        <h6 class="fw-bold mb-3">Đồng bộ View Count</h6>
                                        <p class="text-dim small mb-3">Trigger đồng bộ thủ công từ YouTube và Deezer.</p>
                                        <button type="button" id="syncNowBtn" class="btn btn-outline-light rounded-pill px-4 fw-bold btn-sm">
                                            🔄 Sync Now
                                        </button>
                                        <div id="syncStatus" class="mt-3 small"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .admin-tabs .nav-link { color: #888; border: 0 !important; background: transparent !important; padding: 12px 24px; font-weight: 700; font-size: 14px; position: relative; }
    .admin-tabs .nav-link.active { color: var(--accent-primary); }
    .admin-tabs .nav-link.active::after { content: ''; position: absolute; bottom: 0; left: 24px; right: 24px; height: 3px; background: var(--accent-primary); border-radius: 3px; }
    .form-control-pro { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; padding: 12px 18px; width: 100%; transition: 0.2s; }
    .form-control-pro:focus { background: rgba(255,255,255,0.08); border-color: var(--accent-primary); outline: none; }
    .custom-check .form-check-input { background-color: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.2); }
    .custom-check .form-check-input:checked { background-color: var(--accent-primary); border-color: var(--accent-primary); }
</style>

<script>
    // View Count Management JavaScript
    const songId = @Model.SongId;

    // Load current view count on page load
    async function loadViewCount() {
        try {
            const response = await fetch(`/api/songs/${songId}/view-count`);
            if (!response.ok) {
                throw new Error('Failed to load view count');
            }
            const data = await response.json();
            
            // Hide spinner
            document.getElementById('viewCountSpinner').style.display = 'none';
            
            // Format view count
            const formattedCount = formatViewCount(data.viewCount);
            const sourceLabel = getSourceLabel(data.source);
            const cacheLabel = data.isFromCache ? '(cached)' : '(live)';
            
            document.getElementById('viewCountText').innerHTML = `
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <div class="fw-bold text-white fs-4">${formattedCount}</div>
                        <div class="text-dim small">${sourceLabel} ${cacheLabel}</div>
                    </div>
                </div>
            `;
        } catch (error) {
            console.error('Error loading view count:', error);
            document.getElementById('viewCountSpinner').style.display = 'none';
            document.getElementById('viewCountText').innerHTML = '<span class="text-danger">Không thể tải view count</span>';
        }
    }

    // Format view count (170886759 -> "170.9M")
    function formatViewCount(count) {
        if (count >= 1000000) {
            return (count / 1000000).toFixed(1) + 'M';
        } else if (count >= 1000) {
            return (count / 1000).toFixed(1) + 'K';
        }
        return count.toString();
    }

    // Get source label
    function getSourceLabel(source) {
        const labels = {
            'internal': 'lượt nghe nội bộ',
            'youtube': 'từ YouTube',
            'deezer': 'từ Deezer'
        };
        return labels[source.toLowerCase()] || source;
    }

    // Save priority source
    document.getElementById('savePriorityBtn').addEventListener('click', async function() {
        const select = document.getElementById('prioritySourceSelect');
        const source = select.value === '' ? null : parseInt(select.value);
        
        const btn = this;
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
        
        try {
            const response = await fetch(`/api/admin/songs/${songId}/priority-source`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ source: source })
            });
            
            if (!response.ok) {
                throw new Error('Failed to save priority source');
            }
            
            // Show success toast
            showToast('✅ Đã lưu Priority Source thành công!', 'success');
            
            // Reload view count
            await loadViewCount();
        } catch (error) {
            console.error('Error saving priority source:', error);
            showToast('❌ Lỗi khi lưu Priority Source', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });

    // Sync now button
    document.getElementById('syncNowBtn').addEventListener('click', async function() {
        const btn = this;
        const originalText = btn.innerHTML;
        const statusDiv = document.getElementById('syncStatus');
        
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang sync...';
        statusDiv.innerHTML = '<span class="text-dim">Đang enqueue sync job...</span>';
        
        try {
            const response = await fetch(`/api/admin/songs/${songId}/sync-view-count`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });
            
            if (!response.ok) {
                throw new Error('Failed to sync view count');
            }
            
            const data = await response.json();
            statusDiv.innerHTML = '<span class="text-success">✅ Sync job đã được enqueue. View count sẽ được cập nhật trong vài giây.</span>';
            showToast('✅ Sync job đã được enqueue!', 'success');
            
            // Reload view count after 3 seconds
            setTimeout(async () => {
                await loadViewCount();
                statusDiv.innerHTML = '';
            }, 3000);
        } catch (error) {
            console.error('Error syncing view count:', error);
            statusDiv.innerHTML = '<span class="text-danger">❌ Lỗi khi sync view count</span>';
            showToast('❌ Lỗi khi sync view count', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });

    // Simple toast notification
    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed top-0 end-0 m-3`;
        toast.style.zIndex = '9999';
        toast.textContent = message;
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Load view count on page load
    document.addEventListener('DOMContentLoaded', loadViewCount);
</script>
