@model VibeMusic.Application.DTOs.SongDto
@{
    ViewData["Title"] = $"Chi tiết bài hát - {Model.Title}";
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Song Basic Info -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-music me-2"></i>
                        @Model.Title
                    </h4>
                    <small class="text-light">
                        <i class="fas fa-user me-1"></i>
                        @Model.AuthorName
                    </small>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                            {
                                <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm mb-3">
                            }
                            else if (!string.IsNullOrEmpty(Model.AlbumImageUrl))
                            {
                                <img src="@Model.AlbumImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm mb-3">
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                                    <i class="fas fa-music fa-3x text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Thời lượng:</strong></td>
                                    <td>@Model.FormattedDuration</td>
                                </tr>
                                <tr>
                                    <td><strong>Lượt phát:</strong></td>
                                    <td>@Model.FormattedPlayCount</td>
                                </tr>
                                <tr>
                                    <td><strong>Lượt xem:</strong></td>
                                    <td>
                                        <span id="viewCountDisplay">
                                            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                        </span>
                                        <small id="viewCountSource" class="text-muted ms-1"></small>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Ngày phát hành:</strong></td>
                                    <td>@(Model.ReleaseDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td><strong>Nội dung nhạy cảm:</strong></td>
                                    <td>
                                        @if (Model.IsExplicit)
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-exclamation-triangle me-1"></i>
                                                Explicit
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>
                                                Clean
                                            </span>
                                        }
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.AlbumName))
                                {
                                    <tr>
                                        <td><strong>Album:</strong></td>
                                        <td>@Model.AlbumName</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-database me-2"></i>
                        Metadata
                        @if (Model.HasDeezerMetadata)
                        {
                            <span class="badge bg-success ms-2">
                                <i class="fas fa-check me-1"></i>
                                Deezer
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning ms-2">
                                <i class="fas fa-exclamation me-1"></i>
                                Chưa có
                            </span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.HasDeezerMetadata)
                    {
                        <div class="metadata-section">
                            <h6 class="text-primary">
                                <i class="fas fa-music me-1"></i>
                                Thông tin âm nhạc
                            </h6>
                            <table class="table table-sm">
                                @if (Model.BPM.HasValue)
                                {
                                    <tr>
                                        <td><strong>BPM:</strong></td>
                                        <td>@Model.FormattedBPM</td>
                                    </tr>
                                }
                                @if (Model.PopularityRank.HasValue)
                                {
                                    <tr>
                                        <td><strong>Độ phổ biến:</strong></td>
                                        <td>@Model.FormattedPopularity</td>
                                    </tr>
                                }
                                @if (Model.TrackNumber.HasValue)
                                {
                                    <tr>
                                        <td><strong>Track #:</strong></td>
                                        <td>@Model.TrackNumber</td>
                                    </tr>
                                }
                                @if (Model.DiskNumber.HasValue && Model.DiskNumber > 1)
                                {
                                    <tr>
                                        <td><strong>Disk #:</strong></td>
                                        <td>@Model.DiskNumber</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.Isrc))
                                {
                                    <tr>
                                        <td><strong>ISRC:</strong></td>
                                        <td><small class="font-monospace">@Model.Isrc</small></td>
                                    </tr>
                                }
                            </table>

                            @if (!string.IsNullOrEmpty(Model.PreviewUrl))
                            {
                                <div class="mt-3">
                                    <h6 class="text-primary">
                                        <i class="fas fa-play me-1"></i>
                                        Preview
                                    </h6>
                                    <audio controls class="w-100">
                                        <source src="@Model.PreviewUrl" type="audio/mpeg">
                                        Trình duyệt không hỗ trợ audio.
                                    </audio>
                                </div>
                            }

                            @if (Model.AvailableCountries.Any())
                            {
                                <div class="mt-3">
                                    <h6 class="text-primary">
                                        <i class="fas fa-globe me-1"></i>
                                        Có sẵn tại
                                    </h6>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var country in Model.AvailableCountries.Take(10))
                                        {
                                            <span class="badge bg-light text-dark">@country</span>
                                        }
                                        @if (Model.AvailableCountries.Count > 10)
                                        {
                                            <span class="badge bg-secondary">+@(Model.AvailableCountries.Count - 10) khác</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (Model.EnrichedAt.HasValue)
                            {
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        Cập nhật: @Model.EnrichedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        @if (Model.IsMetadataFresh)
                                        {
                                            <span class="badge bg-success ms-1">Mới</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning ms-1">Cũ</span>
                                        }
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-database fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Chưa có metadata từ Deezer</p>
                            @if (User.IsInRole("Admin"))
                            {
                                <button class="btn btn-primary btn-sm" onclick="enrichMetadata(@Model.SongId)">
                                    <i class="fas fa-sync me-1"></i>
                                    Cập nhật Metadata
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Technical Info -->
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-cog me-2"></i>
                        Thông tin kỹ thuật
                    </h6>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Song ID:</strong></td>
                            <td>@Model.SongId</td>
                        </tr>
                        <tr>
                            <td><strong>YouTube ID:</strong></td>
                            <td><small class="font-monospace">@Model.YoutubeVideoId</small></td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.DeezerTrackId))
                        {
                            <tr>
                                <td><strong>Deezer ID:</strong></td>
                                <td><small class="font-monospace">@Model.DeezerTrackId</small></td>
                            </tr>
                        }
                        <tr>
                            <td><strong>Premium:</strong></td>
                            <td>
                                @if (Model.IsPremiumOnly)
                                {
                                    <span class="badge bg-warning">Premium</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Free</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Lyrics Section -->
    @if (!string.IsNullOrEmpty(Model.LyricsText))
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-align-left me-2"></i>
                            Lời bài hát
                        </h5>
                    </div>
                    <div class="card-body">
                        <pre class="lyrics-text">@Model.LyricsText</pre>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Admin Actions -->
    @if (User.IsInRole("Admin"))
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0">
                            <i class="fas fa-tools me-2"></i>
                            Admin Actions
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-primary" onclick="enrichMetadata(@Model.SongId)">
                                <i class="fas fa-sync me-1"></i>
                                Cập nhật Metadata
                            </button>
                            <a href="/Song/Edit/@Model.SongId" class="btn btn-outline-secondary">
                                <i class="fas fa-edit me-1"></i>
                                Chỉnh sửa
                            </a>
                            <a href="/AdminSong" class="btn btn-outline-info">
                                <i class="fas fa-list me-1"></i>
                                Quản lý bài hát
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
.lyrics-text {
    white-space: pre-wrap;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    background-color: #f8f9fa;
    border: none;
    margin: 0;
}

.metadata-section h6 {
    border-bottom: 1px solid #dee2e6;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
}

.badge {
    font-size: 0.75em;
}
</style>

@if (User.IsInRole("Admin"))
{
    <script>
        async function enrichMetadata(songId) {
            const button = event.target;
            const originalText = button.innerHTML;
            
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang cập nhật...';
            
            try {
                const response = await fetch(`/Admin/SongMetadata/EnrichSong/${songId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ ' + result.message);
                    location.reload(); // Refresh to show updated metadata
                } else {
                    alert('⚠️ ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('❌ Có lỗi xảy ra khi cập nhật metadata.');
            } finally {
                button.disabled = false;
                button.innerHTML = originalText;
            }
        }
    </script>
}

<script>
    // Load view count asynchronously
    (async function loadViewCount() {
        const songId = @Model.SongId;
        const displayEl = document.getElementById('viewCountDisplay');
        const sourceEl = document.getElementById('viewCountSource');
        
        if (!displayEl) return;
        
        try {
            const response = await fetch(`/api/songs/${songId}/view-count`);
            if (!response.ok) {
                displayEl.textContent = 'N/A';
                if (sourceEl) sourceEl.textContent = '';
                return;
            }
            
            const data = await response.json();
            
            // Format view count
            const count = data.viewCount;
            let formatted;
            if (count == null || count === undefined) {
                formatted = 'N/A';
            } else if (count >= 1000000) {
                formatted = (count / 1000000).toFixed(1) + 'M';
            } else if (count >= 1000) {
                formatted = (count / 1000).toFixed(1) + 'K';
            } else {
                formatted = count.toString();
            }
            
            // Source label
            const sourceLabels = {
                'internal': 'lượt nghe nội bộ',
                'youtube': 'từ YouTube',
                'deezer': 'từ Deezer'
            };
            const sourceLabel = sourceLabels[(data.source || '').toLowerCase()] || data.source || '';
            
            displayEl.textContent = formatted;
            if (sourceEl) sourceEl.textContent = sourceLabel;
        } catch (error) {
            console.error('Error loading view count:', error);
            if (displayEl) displayEl.textContent = 'N/A';
            if (sourceEl) sourceEl.textContent = '';
        }
    })();
</script>
